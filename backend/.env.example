// .env.example
PORT=5000
NODE_ENV=development

JWT_SECRET=change_me_in_production_min_32_chars
JWT_REFRESH_SECRET=another_secret_for_refresh_tokens
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

DATABASE_URL="postgresql://user:password@localhost:5432/licensekeys_db?schema=public"
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/licensekeys"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CART_TTL_SECONDS=86400

# SendavaPay — Mobile Money Afrique (MTN, Orange, Moov...)
# Auth: Bearer token (Authorization: Bearer sk_live_...)
# Dashboard : https://sendavapay.com/dashboard
SENDAVAPAY_API_KEY=sk_live_votre_cle_api
SENDAVAPAY_BASE_URL=https://sendavapay.com/api/v1
# Récupérer ce secret dans votre dashboard SendavaPay > Webhooks
SENDAVAPAY_WEBHOOK_SECRET=whsec_votre_secret_webhook

# Whop — Paiement international par carte bancaire (Visa, Mastercard, Apple Pay, Google Pay...)
# Dashboard : https://whop.com/dashboard/developer
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
# Taux de conversion XAF → USD (1 USD ≈ 620 XAF)
WHOP_XAF_TO_USD_RATE=0.0016

FRONTEND_URL=http://localhost:5173

# Emails (clés licence, reset mot de passe, remboursements) — sans ceci, aucun mail n’est parti
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Boutique Licences <noreply@example.com>"
SUPPORT_EMAIL=support@example.com

# URL publique du backend (pour les chemins images /uploads/…), sans /api
API_PUBLIC_URL=http://localhost:5000

BCRYPT_ROUNDS=12